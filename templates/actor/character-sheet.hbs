<form class="ved-sheet character-sheet">

  <header class="sheet-header">
    <div class="header-top">
      <img class="profile" data-edit="img" src="{{actor.img}}" title="{{actor.name}}" />
      <div class="header-fields">
        <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'VED.CharacterName'}}" />
        <div class="row">
          <label>{{localize 'VED.Magnitude.Label'}}
            <select name="system.magnitude">
              {{#each config.magnitudes as |m k|}}
                <option value="{{k}}" {{#if (ved-eq @root.system.magnitude k)}}selected{{/if}}>{{ved-magnitude-label k}}</option>
              {{/each}}
            </select>
          </label>
          <label>{{localize 'VED.Race'}}
            <input type="text" name="system.raceName" value="{{system.raceName}}" />
          </label>
          <label>{{localize 'VED.Archetype.Label'}}
            <input type="text" name="system.archetype" value="{{system.archetype}}" />
          </label>
          <label>{{localize 'VED.Society'}}
            <input type="text" name="system.society" value="{{system.society}}" />
          </label>
        </div>
      </div>
    </div>

    {{> (concat 'systems/veiled-earth-directive/templates/actor/parts/header-grid.hbs')}}
  </header>

  <section class="sheet-body">

    {{> (concat 'systems/veiled-earth-directive/templates/actor/parts/skills.hbs')}}

    {{> (concat 'systems/veiled-earth-directive/templates/actor/parts/conditions.hbs')}}

    <section class="biography">
      <h3>{{localize 'VED.Biography'}}</h3>
      {{{enrichedBiography}}}
      <textarea name="system.biography">{{system.biography}}</textarea>
    </section>

  </section>

</form>
