<section class="resources">
  {{#each config.resources as |res key|}}
    {{#with (lookup @root.system.resources key) as |r|}}
    <div class="resource" data-resource="{{key}}">
      <label>{{ved-resource-label key}}</label>
      <div class="bar">
        <input type="number" name="system.resources.{{key}}.value" value="{{r.value}}" />
        <span>/</span>
        <input type="number" name="system.resources.{{key}}.max" value="{{r.max}}" readonly />
      </div>
    </div>
    {{/with}}
  {{/each}}
</section>
